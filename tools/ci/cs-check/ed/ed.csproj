<!--
  Editor assembly (Assets/CraDev/Editor) uchun taxminiy kompilyatsiya. Eski UnityEditor.dll (2018.1, NuGet)
  ishlatiladi: unda yo'q API xatolari ../edbase.txt bazasida turadi va e'tiborga olinmaydi.
  check.sh beradigan xususiyatlar: RepoRoot, HarnessDir (oxirida "/" bilan), UnityEditorDll (dll yo'li).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>UNITY_EDITOR;ENABLE_LEGACY_INPUT_MANAGER;UNITY_STANDALONE_WIN</DefineConstants>
    <NoWarn>CS0414;CS0649;CS0169;CS0067;CS8632;CS0618;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <PackageReference Include="Unity3D.UnityEngine.UI" Version="2020.3.21" />
    <Reference Include="UnityEditor"><HintPath>$(UnityEditorDll)</HintPath></Reference>
    <ProjectReference Include="../check.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(HarnessDir)ed/EdStubs.cs" />
    <Compile Include="$(RepoRoot)Assets/CraDev/Editor/**/*.cs" />
  </ItemGroup>
</Project>
